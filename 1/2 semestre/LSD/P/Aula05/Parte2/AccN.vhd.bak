library IEEE;
use IEEE.STD_LOGIC_1164.all;
use IEEE.NUMERIC_std.all;

entity AccN is
	generic ( N : positive := 8);
	port
	(
		dataIn : in std_logic_vector(N-1 downto 0);
		dataOut : out std_logic_vector(N-1 downto 0);
		reset : in std_logic;
		enable : in std_logic;
		clock : in std_logic
		);
end AccN;

architecture behavioral of AccN is
	signal s_regOut, s_adderOut : std_logic_vector((N-1) downto 0);
begin
	
	somador : entity work.AdderN(behavioral)
					generic map ( N => N)
					port map(operand0 => dataIn , opreand1 => s_regOut, result => s_adderOut);
	
	registo : entity work.RegN(behavioral)
					generic map(N => N)
					port map(dadtaIn => s_adderOut, dataOut => s_regOut);
					
	dataOut <= s_RegOut;
	
end behavioral;
	
	