library IEEE;
use IEEE.STD_LOGIC_1164.all;
use IEEE.NUMERIC_STD.all;

entity TimerN is
	generic( N : positive := 8);
	port(
			start : in std_logic;
			reset : in std_logic;
			clk : in std_logic;
			enable : in std_logic;
			timerOut : out std_logic);
end TimerN;
			
architecture behavioral of TimerN is
	begin
		process(clk)
			if (rising_edge(clk)) then
				if (reset = '1') then 
					timerOut <= '0';
				elsif (enable = '1') then
					timerOut <= Unsigned(timerOut - 1);
			end if;
		end if;
	end process;
end behavioral;
				